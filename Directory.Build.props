<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <Authors>TorrWind contributors</Authors>
    <Company>TorrWind contributors</Company>
    <Product>TorrWind</Product>
    <Description>Windows desktop client for local and remote TorrServer instances.</Description>
    <Copyright>Copyright (c) TorrWind contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <AssemblyInformationalVersion>$(Version)</AssemblyInformationalVersion>
    <RepositoryUrl>https://github.com/trinity-aml/TorrWind</RepositoryUrl>
  </PropertyGroup>
</Project>
