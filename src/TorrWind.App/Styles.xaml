<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorBackground">#F6F7F9</Color>
  <Color x:Key="ColorSurface">#FFFFFF</Color>
  <Color x:Key="ColorSidebar">#18202B</Color>
  <Color x:Key="ColorAccent">#1E7A5F</Color>
  <Color x:Key="ColorAccentSoft">#E8F3EF</Color>
  <Color x:Key="ColorBorder">#D8DEE6</Color>
  <Color x:Key="ColorText">#17202A</Color>
  <Color x:Key="ColorMuted">#647184</Color>
  <Color x:Key="ColorButtonBackground">#FFFFFF</Color>
  <Color x:Key="ColorButtonHover">#F0F4F7</Color>
  <Color x:Key="ColorButtonPressed">#E4EAF0</Color>
  <Color x:Key="ColorButtonDisabledBackground">#EEF1F4</Color>
  <Color x:Key="ColorButtonDisabledForeground">#9AA6B2</Color>
  <Color x:Key="ColorPrimaryButtonHover">#176B52</Color>
  <Color x:Key="ColorPrimaryButtonPressed">#125941</Color>

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBackground}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="White" />
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="#B9C3D0" />
  <SolidColorBrush x:Key="VersionBadgeBrush" Color="#28445F" />
  <SolidColorBrush x:Key="VersionBadgeTextBrush" Color="#D9E2EC" />
  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ColorButtonBackground}" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ColorButtonHover}" />
  <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ColorButtonPressed}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ColorText}" />
  <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="{StaticResource ColorButtonDisabledBackground}" />
  <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="{StaticResource ColorButtonDisabledForeground}" />
  <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource ColorPrimaryButtonHover}" />
  <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="{StaticResource ColorPrimaryButtonPressed}" />
  <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="White" />

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="ButtonChrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="ButtonChrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource PrimaryButtonPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,4,16,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style TargetType="ListView">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
</ResourceDictionary>
