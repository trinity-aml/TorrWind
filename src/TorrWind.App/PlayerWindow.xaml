<Window x:Class="TorrWind.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Width="1100"
        Height="680"
        MinWidth="760"
        MinHeight="460"
        Background="#101418"
        Loaded="OnLoaded"
        Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="#05070A">
      <vlc:VideoView x:Name="VideoView" />
      <TextBlock x:Name="StatusText"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="#C9D3DF"
                 FontSize="16"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Margin="24" />
    </Grid>

    <Border Grid.Row="1" Background="#17202A" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

      <TextBlock x:Name="TitleText"
                 Grid.Row="0"
                 Grid.ColumnSpan="3"
                 Foreground="#F5F7FA"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"
                 Margin="0,0,0,10" />

      <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
        <Button x:Name="PlayPauseButton" Click="OnPlayPause" MinWidth="88" />
        <Button x:Name="StopButton" Click="OnStop" MinWidth="76" />
      </StackPanel>

      <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="112" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TimeText"
                   Grid.Column="0"
                   Foreground="#DDE5EE"
                   VerticalAlignment="Center"
                   TextAlignment="Right"
                   Margin="0,0,10,0" />
        <Slider x:Name="PositionSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="1000"
                VerticalAlignment="Center"
                PreviewMouseDown="OnPositionMouseDown"
                PreviewMouseUp="OnPositionMouseUp"
                ValueChanged="OnPositionValueChanged" />
      </Grid>

      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="VolumeLabel"
                   Foreground="#DDE5EE"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <Slider x:Name="VolumeSlider"
                Width="120"
                Minimum="0"
                Maximum="150"
                Value="100"
                VerticalAlignment="Center"
                ValueChanged="OnVolumeValueChanged" />
        <Button x:Name="CloseButton" Click="OnClose" MinWidth="76" Margin="10,0,0,0" />
      </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
