<Window x:Class="TorrWind.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Width="1180"
        Height="720"
        MinWidth="860"
        MinHeight="520"
        Background="#101418"
        PreviewKeyDown="OnWindowKeyDown"
        Loaded="OnLoaded"
        Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="PlayerIconButton" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#F5F7FA" />
      <Setter Property="Background" Value="#243140" />
      <Setter Property="BorderBrush" Value="#34485E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid x:Name="RootLayout" PreviewMouseRightButtonUp="OnPlayerRightClick">
    <Grid.ContextMenu>
      <ContextMenu x:Name="PlayerContextMenu" Opened="OnPlayerContextMenuOpened" />
    </Grid.ContextMenu>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PlayerSidebarColumn" Width="320" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="VideoHost"
            Grid.Column="0"
            Background="#05070A"
            MouseLeftButtonDown="OnVideoHostMouseLeftButtonDown"
            MouseRightButtonUp="OnPlayerRightClick">
        <vlc:VideoView x:Name="VideoView"
                       MouseLeftButtonDown="OnVideoHostMouseLeftButtonDown"
                       MouseRightButtonUp="OnPlayerRightClick" />
        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#C9D3DF"
                   FontSize="16"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="24" />
      </Grid>

      <Border x:Name="PlayerSidebar" Grid.Column="1" Background="#121A23" BorderBrush="#263445" BorderThickness="1,0,0,0">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="PlaylistHeaderText"
                     Grid.Row="0"
                     Foreground="#F5F7FA"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />

          <ListBox x:Name="PlaylistList"
                   Grid.Row="1"
                   Background="#0B1118"
                   BorderBrush="#2A394B"
                   Foreground="#E6EDF5"
                   SelectionChanged="OnPlaylistSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding NumberText}"
                             Foreground="#8FA1B5"
                             VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Title}"
                             TextWrapping="Wrap"
                             Foreground="#E6EDF5" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TrackSettingsHeaderText"
                       Foreground="#F5F7FA"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <TextBlock x:Name="AudioTrackLabel"
                       Foreground="#B8C5D4"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="AudioTrackCombo"
                      SelectionChanged="OnAudioTrackSelectionChanged"
                      Margin="0,0,0,8" />

            <TextBlock x:Name="AudioDelayLabel"
                       Foreground="#B8C5D4"
                       Margin="0,0,0,4" />
            <Slider x:Name="AudioDelaySlider"
                    Minimum="-5000"
                    Maximum="5000"
                    TickFrequency="250"
                    IsSnapToTickEnabled="True"
                    ValueChanged="OnAudioDelayChanged"
                    Margin="0,0,0,8" />

            <TextBlock x:Name="VideoTrackLabel"
                       Foreground="#B8C5D4"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="VideoTrackCombo"
                      SelectionChanged="OnVideoTrackSelectionChanged"
                      Margin="0,0,0,8" />

            <TextBlock x:Name="AspectRatioLabel"
                       Foreground="#B8C5D4"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="AspectRatioCombo"
                      SelectionChanged="OnAspectRatioSelectionChanged"
                      Margin="0,0,0,8" />

            <TextBlock x:Name="SubtitleTrackLabel"
                       Foreground="#B8C5D4"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="SubtitleTrackCombo"
                      SelectionChanged="OnSubtitleTrackSelectionChanged"
                      Margin="0,0,0,8" />

            <TextBlock x:Name="SubtitleDelayLabel"
                       Foreground="#B8C5D4"
                       Margin="0,0,0,4" />
            <Slider x:Name="SubtitleDelaySlider"
                    Minimum="-5000"
                    Maximum="5000"
                    TickFrequency="250"
                    IsSnapToTickEnabled="True"
                    ValueChanged="OnSubtitleDelayChanged" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="PlayerControlsBar" Grid.Row="1" Background="#17202A" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Foreground="#F5F7FA"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="PreviousButton"
                  Content="&#xE892;"
                  Style="{StaticResource PlayerIconButton}"
                  Click="OnPrevious" />
          <Button x:Name="PlayPauseButton"
                  Content="&#xE769;"
                  Style="{StaticResource PlayerIconButton}"
                  Click="OnPlayPause" />
          <Button x:Name="StopButton"
                  Content="&#xE71A;"
                  Style="{StaticResource PlayerIconButton}"
                  Click="OnStop" />
          <Button x:Name="NextButton"
                  Content="&#xE893;"
                  Style="{StaticResource PlayerIconButton}"
                  Click="OnNext" />
          <Button x:Name="FullscreenButton"
                  Content="&#xE740;"
                  Style="{StaticResource PlayerIconButton}"
                  Click="OnFullscreen" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TimeText"
                     Grid.Column="0"
                     Foreground="#DDE5EE"
                     VerticalAlignment="Center"
                     TextAlignment="Right"
                     Margin="0,0,10,0" />
          <Slider x:Name="PositionSlider"
                  Grid.Column="1"
                  Minimum="0"
                  Maximum="1000"
                  VerticalAlignment="Center"
                  PreviewMouseDown="OnPositionMouseDown"
                  PreviewMouseUp="OnPositionMouseUp"
                  ValueChanged="OnPositionValueChanged" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="VolumeLabel"
                     Foreground="#DDE5EE"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <Slider x:Name="VolumeSlider"
                  Width="120"
                  Minimum="0"
                  Maximum="150"
                  Value="100"
                  VerticalAlignment="Center"
                  ValueChanged="OnVolumeValueChanged" />
          <Button x:Name="CloseButton"
                  Content="&#xE711;"
                  Style="{StaticResource PlayerIconButton}"
                  Click="OnClose"
                  Margin="10,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
