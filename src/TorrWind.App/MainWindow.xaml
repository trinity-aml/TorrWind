                      <CheckBox Content="{Binding L[FieldDisableUpnp]}" IsChecked="{Binding TorrServerRuntimeSettings.DisableUpnp}" />
                      <CheckBox Content="{Binding L[FieldDisableDht]}" IsChecked="{Binding TorrServerRuntimeSettings.DisableDht}" />
                      <CheckBox Content="{Binding L[FieldDisablePex]}" IsChecked="{Binding TorrServerRuntimeSettings.DisablePex}" />
                      <CheckBox Content="{Binding L[FieldDisableUpload]}" IsChecked="{Binding TorrServerRuntimeSettings.DisableUpload}" />
                      <CheckBox Content="{Binding L[FieldEnableLpd]}" IsChecked="{Binding TorrServerRuntimeSettings.EnableLpd}" />
                      <CheckBox Content="{Binding L[FieldLpdIPv6]}" IsChecked="{Binding TorrServerRuntimeSettings.LpdIPv6}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[FieldAdvancedRuntime]}" VerticalAlignment="Center" Margin="0,8,12,10" />
                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,10">
                      <CheckBox Content="{Binding L[FieldResponsiveMode]}" IsChecked="{Binding TorrServerRuntimeSettings.ResponsiveMode}" />
                      <CheckBox Content="{Binding L[FieldShowFsActiveTorrents]}" IsChecked="{Binding TorrServerRuntimeSettings.ShowFsActiveTorrents}" />
                      <CheckBox Content="{Binding L[FieldStoreSettingsInJson]}" IsChecked="{Binding TorrServerRuntimeSettings.StoreSettingsInJson}" />
                      <CheckBox Content="{Binding L[FieldStoreViewedInJson]}" IsChecked="{Binding TorrServerRuntimeSettings.StoreViewedInJson}" />
                      <CheckBox Content="{Binding L[FieldTrackTimecode]}" IsChecked="{Binding TorrServerRuntimeSettings.TrackTimecode}" />
                    </WrapPanel>

                        </Grid>
                      </TabItem>

                      <TabItem Header="{Binding L[SettingsTabTmdb]}">
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldTmdb]}" VerticalAlignment="Center" Margin="0,8,12,10" />
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,8,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldTmdbApiKey]}" VerticalAlignment="Center" Margin="0,0,8,8" />
                      <TextBox Grid.Row="0" Grid.Column="1" MinWidth="180" Text="{Binding TorrServerRuntimeSettings.TmdbApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" />
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding L[FieldTmdbApiUrl]}" VerticalAlignment="Center" Margin="0,0,8,8" />
                      <TextBox Grid.Row="0" Grid.Column="3" MinWidth="180" Text="{Binding TorrServerRuntimeSettings.TmdbApiUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[FieldTmdbImageUrl]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox Grid.Row="1" Grid.Column="1" MinWidth="180" Text="{Binding TorrServerRuntimeSettings.TmdbImageUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding L[FieldTmdbImageUrlRu]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox Grid.Row="1" Grid.Column="3" MinWidth="180" Text="{Binding TorrServerRuntimeSettings.TmdbImageUrlRu, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                        </Grid>
                      </TabItem>
                    </TabControl>

                    <StackPanel Orientation="Horizontal" Margin="220,6,0,0" IsEnabled="{Binding CanEditTorrServerSettings}">
                      <Button Content="{Binding L[ActionSave]}" Command="{Binding ApplyLocalServerSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                      <Button Content="{Binding L[ActionApplyRuntimeSettings]}" Command="{Binding ApplyLocalServerSettingsCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding L[NavServiceSettings]}">
              <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                  <StackPanel>
                    <TabControl Margin="0,0,0,14">
                      <TabItem Header="{Binding L[SettingsTabLocalServer]}">
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldTorrServerExe]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding LocalServer.ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="1" Content="{Binding L[ActionBrowse]}" Click="OnBrowseTorrServerExecutable" Margin="10,0,0,0" />
                      <Button Grid.Column="2" Content="{Binding L[ActionOpenFolder]}" Command="{Binding OpenTorrServerExecutableFolderCommand}" Margin="10,0,0,0" />
                      <CheckBox Grid.Column="3" Content="{Binding L[FieldStartLocalServerWithApp]}" IsChecked="{Binding LocalServer.Enabled}" Margin="14,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[FieldDataPath]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding LocalServer.DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="1" Content="{Binding L[ActionBrowse]}" Click="OnBrowseDataDirectory" Margin="10,0,0,0" />
                      <Button Grid.Column="2" Content="{Binding L[ActionOpenFolder]}" Command="{Binding OpenLocalServerDataFolderCommand}" Margin="10,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[FieldWhiteList]}" VerticalAlignment="Top" Margin="0,8,12,10" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding LocalServer.WhiteList, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="72"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,8,0,10" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding L[FieldBlackList]}" VerticalAlignment="Top" Margin="0,8,12,0" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding LocalServer.BlackList, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="72"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,8,0,0" />
                        </Grid>
                      </TabItem>

                      <TabItem Header="{Binding L[SettingsTabWindowsService]}">
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldService]}" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                      <CheckBox Content="{Binding L[FieldRunAsService]}" IsChecked="{Binding LocalServer.RunAsWindowsService}" />
                      <Button Content="{Binding L[ActionInstallService]}" Command="{Binding InstallServiceCommand}" />
                      <Button Content="{Binding L[ActionUninstallService]}" Command="{Binding UninstallServiceCommand}" />
                      <Button Content="{Binding L[ActionStartService]}" Command="{Binding StartServiceCommand}" />
                      <Button Content="{Binding L[ActionStopService]}" Command="{Binding StopServiceCommand}" />
                      <Button Content="{Binding L[ActionQueryServiceStatus]}" Command="{Binding QueryServiceStatusCommand}" />
                      <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" />
                    </WrapPanel>

                        </Grid>
                      </TabItem>

                      <TabItem Header="{Binding L[SettingsTabTorrServerVersions]}">

                    <Grid Margin="0,14,0,10">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                      </Grid.RowDefinitions>
                      <WrapPanel Grid.Row="0">
                        <Button Content="{Binding L[ActionCheckTorrServerUpdate]}" Command="{Binding CheckTorrServerUpdateCommand}" />
                        <Button Content="{Binding L[ActionDownloadTorrServer]}" Command="{Binding DownloadTorrServerCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding L[ActionLoadTorrServerReleases]}" Command="{Binding LoadTorrServerReleasesCommand}" />
                        <Button Content="{Binding L[ActionDownloadSelectedTorrServerRelease]}" Command="{Binding DownloadSelectedTorrServerReleaseCommand}" />
                        <Button Content="{Binding L[ActionRollbackTorrServer]}" Command="{Binding RollbackTorrServerCommand}" />
                        <Button Content="{Binding L[ActionStartLocalServer]}" Command="{Binding StartLocalServerCommand}" />
                        <Button Content="{Binding L[ActionStopLocalServer]}" Command="{Binding StopLocalServerCommand}" />
                      </WrapPanel>
                      <TextBlock Grid.Row="1" Text="{Binding TorrServerReleaseText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <ListView Grid.Row="2" ItemsSource="{Binding TorrServerReleases}" SelectedItem="{Binding SelectedTorrServerRelease}" Margin="0,8,0,0">
                        <ListView.View>
                          <GridView>
                            <GridViewColumn Header="{Binding L[ColumnVersion]}" DisplayMemberBinding="{Binding Version}" Width="150" />
                            <GridViewColumn Header="{Binding L[ColumnPublished]}" DisplayMemberBinding="{Binding PublishedAtText}" Width="150" />
                            <GridViewColumn Header="{Binding L[ColumnSize]}" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                            <GridViewColumn Header="{Binding L[ColumnChecksum]}" DisplayMemberBinding="{Binding ChecksumText}" Width="120" />
                            <GridViewColumn Header="{Binding L[ColumnAsset]}" DisplayMemberBinding="{Binding AssetName}" Width="330" />
                          </GridView>
                        </ListView.View>
                      </ListView>
                      <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding L[FieldInstalledTorrServerVersions]}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <Button Content="{Binding L[ActionRefreshInstalledTorrServers]}" Command="{Binding RefreshInstalledTorrServersCommand}" />
                        <Button Content="{Binding L[ActionOpenFolder]}" Command="{Binding OpenTorrServerVersionsFolderCommand}" />
                        <Button Content="{Binding L[ActionUseInstalledTorrServer]}" Command="{Binding UseSelectedInstalledTorrServerCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding L[ActionOpenSelectedFolder]}" Command="{Binding OpenSelectedInstalledTorrServerFolderCommand}" />
                        <Button Content="{Binding L[ActionDeleteInstalledTorrServer]}" Command="{Binding DeleteSelectedInstalledTorrServerCommand}" />
                      </WrapPanel>
                      <ListView Grid.Row="4" ItemsSource="{Binding InstalledTorrServers}" SelectedItem="{Binding SelectedInstalledTorrServer}" Margin="0,8,0,0">
                        <ListView.View>
                          <GridView>
                            <GridViewColumn Header="{Binding L[ColumnVersion]}" DisplayMemberBinding="{Binding Version}" Width="150" />
                            <GridViewColumn Header="{Binding L[ColumnTime]}" DisplayMemberBinding="{Binding ModifiedAtText}" Width="150" />
                            <GridViewColumn Header="{Binding L[ColumnSize]}" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                            <GridViewColumn Header="{Binding L[ColumnPath]}" DisplayMemberBinding="{Binding ExecutablePath}" Width="520" />
                          </GridView>
                        </ListView.View>
                      </ListView>
                    </Grid>

                      </TabItem>

                      <TabItem Header="{Binding L[SettingsTabPlayer]}">
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldPlayer]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                      <ComboBox Width="220"
                                ItemsSource="{Binding PlayerKindOptions}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Kind"
                                SelectedValue="{Binding Player.PreferredPlayer}" />
                      <CheckBox Content="{Binding L[FieldPreferDirectStream]}" IsChecked="{Binding Player.PreferDirectStreamUrl}" Margin="14,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[FieldCustomPlayer]}" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding Player.CustomPlayerPath, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="1" Content="{Binding L[ActionBrowse]}" Click="OnBrowseCustomPlayer" Margin="10,0,0,0" />
                    </Grid>

                        </Grid>
                      </TabItem>

                      <TabItem Header="{Binding L[SettingsTabBackups]}">
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldSettingsBackups]}" VerticalAlignment="Top" Margin="0,8,12,0" />
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,10,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                      </Grid.RowDefinitions>
                      <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding L[ActionRefreshSettingsBackups]}" Command="{Binding RefreshSettingsBackupsCommand}" />
                        <Button Content="{Binding L[ActionCreateSettingsBackup]}" Command="{Binding CreateSettingsBackupCommand}" />
                        <Button Content="{Binding L[ActionOpenFolder]}" Command="{Binding OpenSettingsBackupsFolderCommand}" />
                        <Button Content="{Binding L[ActionRestoreSelectedBackup]}" Command="{Binding RestoreSelectedSettingsBackupCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding L[ActionDeleteSettingsBackup]}" Command="{Binding DeleteSelectedSettingsBackupCommand}" />
                        <Button Content="{Binding L[ActionBrowseBackupFile]}" Click="OnRestoreSettingsBackup" />
                        <TextBlock Text="{Binding L[FieldBackupRetentionCount]}" VerticalAlignment="Center" Margin="14,0,8,0" />
                        <TextBox Width="70" Text="{Binding SettingsBackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding L[FieldBackupRetentionHint]}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                      </WrapPanel>
                      <ListView Grid.Row="1" ItemsSource="{Binding SettingsBackups}" SelectedItem="{Binding SelectedSettingsBackup}">
                        <ListView.View>
                          <GridView>
                            <GridViewColumn Header="{Binding L[ColumnName]}" DisplayMemberBinding="{Binding FileName}" Width="260" />
                            <GridViewColumn Header="{Binding L[ColumnTime]}" DisplayMemberBinding="{Binding ModifiedAtText}" Width="150" />
                            <GridViewColumn Header="{Binding L[ColumnSize]}" DisplayMemberBinding="{Binding SizeText}" Width="80" />
                            <GridViewColumn Header="{Binding L[ColumnPath]}" DisplayMemberBinding="{Binding FilePath}" Width="460" />
                          </GridView>
                        </ListView.View>
                      </ListView>
                    </Grid>

                        </Grid>
                      </TabItem>

                      <TabItem Header="{Binding L[SettingsTabTorrWindUpdate]}">
                        <Grid Margin="0,14,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[FieldTorrWindUpdate]}" VerticalAlignment="Top" Margin="0,0,12,0" />
                    <Grid Grid.Row="0" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <WrapPanel Grid.Row="0">
                        <Button Content="{Binding L[ActionCheckTorrWindUpdate]}" Command="{Binding CheckTorrWindUpdateCommand}" />
                        <Button Content="{Binding L[ActionDownloadTorrWindUpdate]}" Command="{Binding DownloadTorrWindUpdateCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding L[ActionOpenDownloadedUpdate]}" Command="{Binding OpenDownloadedTorrWindUpdateCommand}" />
                        <Button Content="{Binding L[ActionOpenFolder]}" Command="{Binding OpenTorrWindUpdatesFolderCommand}" />
                      </WrapPanel>
                      <TextBlock Grid.Row="1" Text="{Binding TorrWindUpdateText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </Grid>

                        </Grid>
                      </TabItem>
                    </TabControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="{Binding L[ActionSave]}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                      <Button Content="{Binding L[ActionExportSettings]}" Click="OnExportSettings" />
                      <Button Content="{Binding L[ActionImportSettings]}" Click="OnImportSettings" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </TabItem>

        <TabItem x:Name="WebUiTab" Header="{Binding L[NavWebUi]}">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="{Binding L[ActionOpenWeb]}" Click="OnOpenWebUi" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" />
            <wv2:WebView2 x:Name="ServerWebView" Grid.Row="1" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
