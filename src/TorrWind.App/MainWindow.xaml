<Window x:Class="TorrWind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding AppDisplayName}"
        Icon="TorrWind.ico"
        Width="1220"
        Height="760"
        MinWidth="1040"
        MinHeight="620"
        Closing="OnClosing"
        Loaded="OnLoaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Window.Resources>

  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="22">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="TorrWind" Foreground="{DynamicResource SidebarTextBrush}" FontSize="26" FontWeight="SemiBold" />
            <Border Background="{DynamicResource VersionBadgeBrush}" CornerRadius="4" Padding="6,2" Margin="10,4,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding AppVersionBadge}" Foreground="{DynamicResource VersionBadgeTextBrush}" FontSize="12" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding ActiveServerLabel}" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,4,0,24" TextWrapping="Wrap" />

          <Button Content="{Binding L[ActionRefresh]}" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
          <Button Content="{Binding L[ActionAddTorrent]}" Click="OnAddTorrentFile" Margin="0,0,0,8" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="{Binding L[ActionAbout]}" Click="OnShowAbout" Margin="0,0,0,8" />
          <Button Content="{Binding L[ActionExitApplication]}" Click="OnExitApplication" Margin="0,0,0,12" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SidebarMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
          <Button Content="{Binding L[NavLibrary]}" Click="OnNavigateLibrary" Margin="0,0,0,8" />
          <Button Content="{Binding L[NavSearch]}" Click="OnNavigateSearch" Margin="0,0,0,8" />
          <Button Content="{Binding L[NavDiagnostics]}" Click="OnNavigateDiagnostics" Margin="0,0,0,8" />
          <Button Content="{Binding L[NavSettings]}" Click="OnNavigateSettings" Margin="0,0,0,8" />
          <Button Content="{Binding L[NavWebUi]}" Click="OnOpenWebUi" Margin="0,0,0,8" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="{Binding L[DashboardTitle]}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="{Binding L[DashboardSubtitle]}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Right"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding L[FieldLanguage]}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="150" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" />
            <TextBlock Text="{Binding L[FieldTheme]}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox Width="140"
                      ItemsSource="{Binding ThemeOptions}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Border>
      </DockPanel>

      <TabControl x:Name="RootTabs"
                  Grid.Row="1"
                  SelectedIndex="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  TabStripPlacement="Left"
                  SelectionChanged="OnRootTabsSelectionChanged">
        <TabControl.ItemContainerStyle>
          <Style TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
          </Style>
        </TabControl.ItemContainerStyle>
        <TabItem x:Name="LibraryTab" Header="{Binding L[NavLibrary]}">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding NewMagnet, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                <Button Grid.Row="0" Grid.Column="1" Content="{Binding L[ActionAddMagnet]}" Command="{Binding AddMagnetCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,8,10" />
                <Button Grid.Row="0" Grid.Column="2" Content="{Binding L[ActionOpenPlayer]}" Command="{Binding OpenSelectedCommand}" Margin="0,0,0,10" />
                <Button Grid.Row="0" Grid.Column="3" Content="{Binding L[ActionCopyPlaybackUrl]}" Command="{Binding CopyPlaybackUrlCommand}" Margin="0,0,0,10" />
                <Button Grid.Row="0" Grid.Column="4" Content="{Binding L[ActionRemoveTorrent]}" Command="{Binding RemoveTorrentCommand}" Margin="0,0,0,10" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal">
                  <Button Content="{Binding L[ActionRefreshSelectedTorrent]}" Command="{Binding RefreshSelectedTorrentCommand}" Style="{StaticResource PrimaryButton}" />
                  <Button Content="{Binding L[ActionOpenContinuePlaylist]}" Command="{Binding OpenContinuePlaylistCommand}" />
                  <Button Content="{Binding L[ActionOpenPlaylistFromSelected]}" Command="{Binding OpenPlaylistFromSelectedCommand}" />
                  <Button Content="{Binding L[ActionCopyTorrentHash]}" Command="{Binding CopyTorrentHashCommand}" />
                  <Button Content="{Binding L[ActionDropTorrent]}" Command="{Binding DropTorrentCommand}" />
                  <Button Content="{Binding L[ActionWipeTorrents]}" Command="{Binding WipeTorrentsCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" MinWidth="310" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" MinHeight="190" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="*" MinHeight="190" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" ItemsSource="{Binding Torrents}" SelectedItem="{Binding SelectedTorrent}">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />

                          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                      <TextBlock Text="{Binding L[ColumnFile]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Content="{Binding L[ActionClearFileSelection]}"
                              Command="{Binding ClearSelectedTorrentFileCommand}"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right"
                              Margin="10,0,0,0" />
                    </DockPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding SelectedTorrentFiles}" SelectedItem="{Binding SelectedTorrentFile}">
                      <ListView.View>
                        <GridView>
                          <GridViewColumn Header="{Binding L[ColumnSeason]}" DisplayMemberBinding="{Binding SeasonText}" Width="70" />
                          <GridViewColumn Header="{Binding L[ColumnEpisode]}" DisplayMemberBinding="{Binding EpisodeText}" Width="70" />
                          <GridViewColumn Header="{Binding L[ColumnName]}" DisplayMemberBinding="{Binding DisplayName}" Width="380" />
                          <GridViewColumn Header="{Binding L[ColumnResolution]}" DisplayMemberBinding="{Binding ResolutionText}" Width="90" />
                          <GridViewColumn Header="{Binding L[ColumnSize]}" DisplayMemberBinding="{Binding SizeText}" Width="95" />
                        </GridView>
                      </ListView.View>
                    </ListView>
                  </Grid>
                </Border>
              </Grid>

              <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedTorrent.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Image Source="{Binding SelectedTorrentPosterImageUri}"
                           Visibility="{Binding HasSelectedTorrentPoster, Converter={StaticResource BoolToVisibilityConverter}}"
                           MaxHeight="260"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,6">
                        <TextBlock Text="{Binding L[ColumnSize]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.SizeText}" FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                        <TextBlock Text="{Binding L[ColumnProgress]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.ProgressText}" FontWeight="SemiBold" />
                      </StackPanel>

                      <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,6">
                        <TextBlock Text="{Binding L[ColumnSeeds]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.Seeders}" FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                        <TextBlock Text="{Binding L[ColumnPeers]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.Peers}" FontWeight="SemiBold" />
                      </StackPanel>

                      <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,6">
                        <TextBlock Text="{Binding L[ColumnDownloadSpeed]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.DownloadSpeedText}" FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                        <TextBlock Text="{Binding L[ColumnUploadSpeed]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.UploadSpeedText}" FontWeight="SemiBold" />
                      </StackPanel>

                      <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,6">
                        <TextBlock Text="{Binding L[ColumnStatus]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                        <TextBlock Text="{Binding L[ColumnLoaded]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.LoadedText}" FontWeight="SemiBold" />
                      </StackPanel>

                      <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,6">
                        <TextBlock Text="{Binding L[ColumnPreloaded]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.PreloadedText}" FontWeight="SemiBold" />
                      </StackPanel>
                      <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                        <TextBlock Text="{Binding L[ColumnHash]}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedTorrent.Hash}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="SearchTab" Header="{Binding L[NavSearch]}">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding SearchProviderOptions}" SelectedItem="{Binding SelectedSearchProviderOption}" DisplayMemberPath="DisplayName" Margin="0,0,10,10" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,10" />
                <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding SearchHistory}" SelectedItem="{Binding SelectedSearchHistoryItem}" Margin="0,0,10,10" />
                <Button Grid.Row="0" Grid.Column="3" Content="{Binding L[ActionSearch]}" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,10" />
                <Button Grid.Row="0" Grid.Column="4" Content="{Binding L[ActionAddSelected]}" Command="{Binding AddSelectedSearchResultCommand}" Margin="0,0,0,10" />

                <Grid Grid.Row="1" Grid.ColumnSpan="5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding L[FieldCategories]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Column="1" Text="{Binding SearchCategories, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                  <TextBlock Grid.Column="2" Text="{Binding L[FieldMinSeeders]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Column="3" Text="{Binding SearchMinSeeders, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                  <TextBlock Grid.Column="4" Text="{Binding L[FieldMaxSizeGb]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Column="5" Text="{Binding SearchMaxSizeGb, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                  <TextBlock Grid.Column="6" Text="{Binding L[FieldPublishedFrom]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <DatePicker Grid.Column="7" SelectedDate="{Binding SearchPublishedFrom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                  <TextBlock Grid.Column="8" Text="{Binding L[FieldPublishedTo]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <DatePicker Grid.Column="9" SelectedDate="{Binding SearchPublishedTo, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </Grid>
            </Border>

            <ListView Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="{Binding L[ColumnProvider]}" DisplayMemberBinding="{Binding ProviderName}" Width="140" />
                  <GridViewColumn Header="{Binding L[ColumnName]}" DisplayMemberBinding="{Binding Title}" Width="420" />
                  <GridViewColumn Header="{Binding L[ColumnSize]}" DisplayMemberBinding="{Binding SizeText}" Width="110" />
                  <GridViewColumn Header="{Binding L[ColumnSeeds]}" DisplayMemberBinding="{Binding Seeders}" Width="80" />
                  <GridViewColumn Header="{Binding L[ColumnLeechers]}" DisplayMemberBinding="{Binding Leechers}" Width="80" />
                  <GridViewColumn Header="{Binding L[ColumnCategory]}" DisplayMemberBinding="{Binding Category}" Width="100" />
                  <GridViewColumn Header="{Binding L[ColumnPublished]}" DisplayMemberBinding="{Binding PublishedAtText}" Width="150" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </TabItem>

        <TabItem x:Name="IndexersTab" Header="{Binding L[NavIndexers]}" Visibility="Collapsed">
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="310" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding SearchProviders}" SelectedItem="{Binding SelectedSearchProvider}" DisplayMemberPath="Name" />

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                  <Button Content="{Binding L[ActionAddProvider]}" Command="{Binding AddSearchProviderCommand}" Style="{StaticResource PrimaryButton}" />
                  <Button Content="{Binding L[ActionRemoveProvider]}" Command="{Binding RemoveSearchProviderCommand}" />
                  <Button Content="{Binding L[ActionSave]}" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[FieldName]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSearchProvider.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[FieldUrl]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSearchProvider.Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding L[FieldApiKey]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSearchProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding L[FieldCategories]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSearchProvider.Categories, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding L[FieldTimeoutSeconds]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSearchProvider.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding L[FieldFeatures]}" VerticalAlignment="Center" Margin="0,0,12,10" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                  <CheckBox Content="{Binding L[FieldEnabled]}" IsChecked="{Binding SelectedSearchProvider.Enabled, UpdateSourceTrigger=PropertyChanged}" />
                  <CheckBox Content="{Binding L[FieldIgnoreCert]}" IsChecked="{Binding SelectedSearchProvider.IgnoreCertificateErrors, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem x:Name="DiagnosticsTab" Header="{Binding L[NavDiagnostics]}">
          <TabControl Margin="0,14,0,0">
            <TabItem Header="{Binding L[NavDiagnostics]}">
              <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ActiveServerLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding L[ActionRunDiagnostics]}" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,8,0" />
                    <Button Grid.Column="2" Content="{Binding L[ActionCopyDiagnostics]}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="{Binding L[ActionSaveDiagnostics]}" Click="OnSaveDiagnostics" />
                    <Button Grid.Column="4" Content="{Binding L[ActionSaveSupportBundle]}" Click="OnSaveSupportBundle" />
                    <Button Grid.Column="5" Content="{Binding L[ActionCheckServer]}" Command="{Binding CheckServerCommand}" />
                  </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{Binding DiagnosticItems}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="{Binding L[ColumnCheck]}" DisplayMemberBinding="{Binding Name}" Width="260" />
                      <GridViewColumn Header="{Binding L[ColumnValue]}" DisplayMemberBinding="{Binding Value}" Width="760" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding L[NavLogs]}">
              <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LogLocationText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <Button Grid.Row="0" Grid.Column="1" Content="{Binding L[ActionRefreshLogs]}" Command="{Binding RefreshLogsCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,8,0" />
                    <Button Grid.Row="0" Grid.Column="2" Content="{Binding L[ActionCopyLogPaths]}" Command="{Binding CopyLogPathsCommand}" Margin="0,0,8,0" />
                    <Button Grid.Row="0" Grid.Column="3" Content="{Binding L[ActionOpenFolder]}" Command="{Binding OpenLogFoldersCommand}" />
                    <Button Grid.Row="0" Grid.Column="4" Content="{Binding L[ActionClearUserLog]}" Command="{Binding ClearUserLogCommand}" />
                  </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{Binding LogEntries}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="{Binding L[ColumnTime]}" DisplayMemberBinding="{Binding TimestampText}" Width="150" />
                      <GridViewColumn Header="{Binding L[ColumnLevel]}" DisplayMemberBinding="{Binding Level}" Width="90" />
                      <GridViewColumn Header="{Binding L[ColumnSource]}" DisplayMemberBinding="{Binding Source}" Width="150" />
                      <GridViewColumn Header="{Binding L[ColumnMessage]}" DisplayMemberBinding="{Binding Message}" Width="300" />
                      <GridViewColumn Header="{Binding L[ColumnDetails]}" DisplayMemberBinding="{Binding Details}" Width="260" />
                      <GridViewColumn Header="{Binding L[ColumnLogFile]}" DisplayMemberBinding="{Binding LogFile}" Width="320" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </Grid>
            </TabItem>
          </TabControl>
        </TabItem>

