<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TorrWind</AssemblyName>
    <RootNamespace>TorrWind.App</RootNamespace>
    <ApplicationIcon>..\..\assets\TorrWind.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TorrWind.Core\TorrWind.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\locales\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="locales" />
    <Resource Include="..\..\assets\TorrWind.ico" Link="TorrWind.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>
</Project>
